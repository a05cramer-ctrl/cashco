# ---- Public (shown on the site; redeploy after changing) ----
# The coin's mint / contract address. Leave empty until launch: the site shows "Revealed at launch".
NEXT_PUBLIC_COIN_MINT=
NEXT_PUBLIC_X_URL=https://x.com/yourhandle
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/yourgroup
# Share of each creator-fee claim poured to holders, in basis points (8000 = 80%).
NEXT_PUBLIC_MILK_SHARE_BPS=8000
# Optional: launch date for the cattle passport, e.g. 2026-10-10
NEXT_PUBLIC_LAUNCH_DATE=
# Optional: your custom domain (Vercel's production URL is used otherwise)
NEXT_PUBLIC_SITE_URL=

# ---- Server only (secrets: never commit) ----
# Turso database (Vercel Marketplace > Turso adds both automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# A Solana RPC that allows getProgramAccounts (Helius free tier works)
RPC_URL=
# The wallet that launched the coin on pump.fun (it receives the creator fees). Base58 or JSON array.
TREASURY_SECRET_KEY=
# Any long random string; the cron pinger sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Set to true to start milking (claims + payouts). Anything else = paused.
MILKING_ENABLED=false
# Minimum $CASHCOW a wallet must hold to be milked (default 100000)
MIN_HOLD_TOKENS=100000
# Wallets that never get milk (CEX hot wallets, team wallets...), comma separated
EXCLUDE_WALLETS=
